diff --git a/codex-rs/login/src/auth/manager/xswap_lock.rs b/codex-rs/login/src/auth/manager/xswap_lock.rs
new file mode 100644
index 0000000..7a88703
--- /dev/null
+++ b/codex-rs/login/src/auth/manager/xswap_lock.rs
@@ -0,0 +1,177 @@
+use std::fs::File;
+#[cfg(unix)]
+use std::fs::OpenOptions;
+use std::io;
+use std::path::Path;
+
+#[cfg(unix)]
+use std::io::Read;
+#[cfg(unix)]
+use std::os::unix::fs::MetadataExt;
+#[cfg(unix)]
+use std::os::unix::fs::OpenOptionsExt;
+
+const MANAGED_RUNTIME_MARKER: &str = ".xswap-managed-runtime";
+#[cfg(unix)]
+const MANAGED_RUNTIME_MARKER_CONTENTS: &[u8] = b"v1\n";
+#[cfg(unix)]
+const MANAGED_RUNTIME_LOCK: &str = "auth.json.xswap.lock";
+
+/// Holds xswap's process-shared auth lock when the current Codex home opts in.
+/// Dropping the file releases the advisory lock.
+pub(super) enum ManagedRefreshLock {
+    Unmanaged,
+    Locked { _file: File },
+}
+
+impl ManagedRefreshLock {
+    pub(super) fn is_locked(&self) -> bool {
+        matches!(self, Self::Locked { .. })
+    }
+}
+
+pub(super) async fn acquire(codex_home: &Path) -> io::Result<ManagedRefreshLock> {
+    let codex_home = codex_home.to_path_buf();
+    tokio::task::spawn_blocking(move || acquire_blocking(&codex_home))
+        .await
+        .map_err(|error| io::Error::other(format!("xswap auth lock task failed: {error}")))?
+}
+
+fn acquire_blocking(codex_home: &Path) -> io::Result<ManagedRefreshLock> {
+    #[cfg(unix)]
+    {
+        acquire_blocking_unix(codex_home)
+    }
+    #[cfg(windows)]
+    {
+        acquire_blocking_windows(codex_home)
+    }
+    #[cfg(not(any(unix, windows)))]
+    {
+        let marker_path = codex_home.join(MANAGED_RUNTIME_MARKER);
+        match std::fs::symlink_metadata(&marker_path) {
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                Ok(ManagedRefreshLock::Unmanaged)
+            }
+            Ok(_) => Err(io::Error::other(
+                "xswap managed runtime auth locking is unsupported on this platform",
+            )),
+            Err(error) => Err(managed_runtime_error("cannot inspect marker", error)),
+        }
+    }
+}
+
+#[cfg(unix)]
+fn acquire_blocking_unix(codex_home: &Path) -> io::Result<ManagedRefreshLock> {
+    let marker_path = codex_home.join(MANAGED_RUNTIME_MARKER);
+    let mut marker_options = OpenOptions::new();
+    marker_options
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    let mut marker_file = match marker_options.open(&marker_path) {
+        Ok(file) => file,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            return Ok(ManagedRefreshLock::Unmanaged);
+        }
+        Err(error) => return Err(managed_runtime_error("cannot open marker", error)),
+    };
+
+    validate_private_home(codex_home)?;
+    let marker_metadata = marker_file
+        .metadata()
+        .map_err(|error| managed_runtime_error("cannot inspect marker", error))?;
+    validate_private_file(&marker_metadata, "managed-runtime marker")?;
+
+    let mut marker_contents = Vec::new();
+    marker_file
+        .read_to_end(&mut marker_contents)
+        .map_err(|error| managed_runtime_error("cannot read marker", error))?;
+    if marker_contents != MANAGED_RUNTIME_MARKER_CONTENTS {
+        return Err(io::Error::other(
+            "invalid xswap managed-runtime marker: expected version v1",
+        ));
+    }
+
+    let lock_path = codex_home.join(MANAGED_RUNTIME_LOCK);
+    let lock_file = open_private_lock_file(&lock_path)?;
+    let lock_metadata = lock_file
+        .metadata()
+        .map_err(|error| managed_runtime_error("cannot inspect auth lock", error))?;
+    validate_private_file(&lock_metadata, "auth lock")?;
+    lock_file
+        .lock()
+        .map_err(|error| managed_runtime_error("cannot acquire auth lock", error))?;
+
+    Ok(ManagedRefreshLock::Locked { _file: lock_file })
+}
+
+#[cfg(windows)]
+fn acquire_blocking_windows(codex_home: &Path) -> io::Result<ManagedRefreshLock> {
+    let marker_path = codex_home.join(MANAGED_RUNTIME_MARKER);
+    match std::fs::symlink_metadata(&marker_path) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(ManagedRefreshLock::Unmanaged),
+        Ok(_) => Err(io::Error::other(
+            "xswap managed runtime auth locking is unsupported on Windows",
+        )),
+        Err(error) => Err(managed_runtime_error("cannot inspect marker", error)),
+    }
+}
+
+#[cfg(unix)]
+fn open_private_lock_file(path: &Path) -> io::Result<File> {
+    let mut options = OpenOptions::new();
+    options
+        .read(true)
+        .write(true)
+        .create(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW);
+    options
+        .open(path)
+        .map_err(|error| managed_runtime_error("cannot open auth lock", error))
+}
+
+#[cfg(unix)]
+fn validate_private_home(codex_home: &Path) -> io::Result<()> {
+    let metadata = std::fs::symlink_metadata(codex_home)
+        .map_err(|error| managed_runtime_error("cannot inspect CODEX_HOME", error))?;
+    if !metadata.file_type().is_dir() {
+        return Err(io::Error::other(
+            "invalid xswap managed runtime: CODEX_HOME must be a real directory",
+        ));
+    }
+    if metadata.uid() != effective_user_id() || metadata.mode() & 0o077 != 0 {
+        return Err(io::Error::other(
+            "invalid xswap managed runtime: CODEX_HOME must be owned by the effective user and not accessible by group or others",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn validate_private_file(metadata: &std::fs::Metadata, name: &str) -> io::Result<()> {
+    if !metadata.file_type().is_file() {
+        return Err(io::Error::other(format!(
+            "invalid xswap {name}: expected a regular file"
+        )));
+    }
+    if metadata.uid() != effective_user_id() || metadata.mode() & 0o777 != 0o600 {
+        return Err(io::Error::other(format!(
+            "invalid xswap {name}: expected effective-user ownership and permissions 0600"
+        )));
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn effective_user_id() -> u32 {
+    // SAFETY: geteuid has no preconditions and does not dereference pointers.
+    unsafe { libc::geteuid() }
+}
+
+fn managed_runtime_error(operation: &str, error: io::Error) -> io::Error {
+    io::Error::new(
+        error.kind(),
+        format!("xswap managed runtime {operation}: {error}"),
+    )
+}
