+#[tokio::test]
+async fn usage_limit_recovery_resumes_once_after_auth_identity_change() {
+    let (mut chat, _events, mut ops) = make_chatwidget_manual(Some("test-model-a")).await;
+    set_chatgpt_auth(&mut chat);
+    chat.thread_id = Some(ThreadId::new());
+    let expected_resume_prompt = chat
+        .usage_limit_resume_prompt()
+        .expect("usage-limit recovery should be enabled");
+    handle_turn_started(&mut chat, "failed-turn");
+    chat.queue_user_message(UserMessage::from("queued follow-up"));
+    chat.on_rate_limit_error(RateLimitErrorKind::UsageLimit, "Usage exhausted".into());
+    assert_no_submit_op(&mut ops);
+
+    chat.update_account_state(
+        /*status_account_display*/ None, /*plan_type*/ None,
+        /*has_chatgpt_account*/ true, /*has_codex_backend_auth*/ true,
+    );
+    chat.handle_auth_identity_changed();
+    chat.on_auth_reload_completed(/*identity_changed*/ true);
+
+    let Op::UserTurn { items, .. } = next_submit_op(&mut ops) else {
+        panic!("expected the parked usage-limit continuation after auth changed");
+    };
+    assert!(
+        matches!(items.as_slice(), [UserInput::Text { text, .. }] if text == &expected_resume_prompt)
+    );
+    assert!(chat.pending_usage_limit_resume_turn.is_none());
+    assert!(!chat.usage_limit_resume_waiting_for_auth_reload);
+    assert_eq!(chat.queued_user_message_texts(), vec!["queued follow-up"]);
+
+    chat.on_auth_reload_completed(/*identity_changed*/ true);
+    assert_no_submit_op(&mut ops);
+    assert_eq!(chat.queued_user_message_texts(), vec!["queued follow-up"]);
+}
