[Unit]
Description=Codex Swap seamless Codext account rotation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env xswap auto --seamless --json
Restart=always
RestartSec=15
UMask=0077

[Install]
WantedBy=default.target
